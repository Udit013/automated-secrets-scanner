# ── Storage ────────────────────────────────────────────────────────────────
# SQLite for local use. For a hosted workspace that keeps its data, use a
# free Postgres (e.g. Neon) with the asyncpg driver:
DATABASE_URL=sqlite+aiosqlite:///./secrets_scanner.db
# DATABASE_URL=postgresql+asyncpg://user:password@host/dbname

# ── Access ─────────────────────────────────────────────────────────────────
# Empty = public demo mode: every endpoint is open, protected only by the
# limits below. Set a long random value to make the workspace private; the
# console then asks for it once per browser session.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ACCESS_TOKEN=

# HMAC key for credential fingerprints. Empty = generated on first boot and
# stored in the database. Set it in production so the key doesn't live next
# to the data, and set the same value for the CLI if you want CI baselines
# to match the console's fingerprints. Changing it re-keys every credential
# (existing triage decisions stop matching).
FINGERPRINT_KEY=

# ── Abuse limits (defaults shown) ──────────────────────────────────────────
SCAN_RATE_LIMIT=10
SCAN_RATE_WINDOW_SECONDS=600
MAX_CONCURRENT_SCANS=3
# Scans per window across ALL clients; protects you when client IPs can't be trusted.
SCAN_GLOBAL_RATE_LIMIT=60
MAX_SCHEDULES=25
# Where the client address comes from for rate limits. Use a header your edge
# overwrites on every request (Render/Cloudflare: cf-connecting-ip; Render sets
# this automatically). Never a header clients can supply.
CLIENT_IP_HEADER=
# Alternative for a known chain of appending proxies: the client is this many
# X-Forwarded-For entries from the right. NOT usable on Render (clients can
# prepend, and the proxy count varies). With neither set, the socket peer is used.
TRUSTED_PROXY_HOPS=0

# ── GitHub ─────────────────────────────────────────────────────────────────
# Optional token, no scopes needed: raises the API limit from 60 to 5000/hr.
GITHUB_TOKEN=

# ── Email alerts (optional; leave SMTP_USER blank to disable) ──────────────
# Alerts fire only for new, untriaged CRITICAL credentials.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL=

# ── Web ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Used for links in alert emails
BACKEND_URL=http://localhost:8000
